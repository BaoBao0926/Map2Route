"""Configuration defaults for the Grounding2Route method."""

from __future__ import annotations

from pathlib import Path

from scripts.make_instruction.make_instruction import REPO_ROOT


METHOD_NAME = "Grounding2Route"
METHOD_ROOT = REPO_ROOT / "resources" / "methods" / METHOD_NAME
PROMPT_DIR = Path(__file__).resolve().parent

DEFAULT_MODEL = "gemini-2.5-flash"
PARSE_MODES = ("intent", "api")
PLANNER_MODES = ("global_progress_astar", "sequential_greedy_astar")
GROUNDING_VARIANTS = (
    "direct_dsl",
    "direct_cap",
    "direct_cap_repair",
    "ir_to_code",
    "ir_code_refine",
    "ir_code_refine_code_repair",
