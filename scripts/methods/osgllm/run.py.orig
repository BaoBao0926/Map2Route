#!/usr/bin/env python3
"""Run the local Optimal Scene Graph Planning adapter on SemPathBench."""

from __future__ import annotations

import argparse
from collections.abc import Mapping
from pathlib import Path
import sys
import time
import traceback
import uuid

if __package__ in {None, ""}:
    repo_root = Path(__file__).resolve().parents[3]
    if str(repo_root) not in sys.path:
        sys.path.insert(0, str(repo_root))

from scripts.evaluation.evaluation_metrics import (
    worst_case_metrics_for_evaluation_error,
)
from scripts.evaluation.evaluate_prediction import evaluate_prediction
from scripts.make_instruction.make_instruction import REPO_ROOT, load_map_state
from scripts.methods.lang2ltl.translator import configured_model
from scripts.methods.osgllm.config import OSGLLMConfig
from scripts.methods.osgllm.pipeline import build_osgllm_trajectory
from scripts.methods.tutorial.utils import (
    collect_prediction_results,
    difficulty_from_instruction,
    display_path,
    iso_now,
    load_existing_result,
    metric_summary,
    output_path_for_prediction,
    print_episode_result,
    print_summary,
    result_from_prediction_record,
    write_prediction_record,
    write_summary,
)
from scripts.methods.util.instructions import (
    DEFAULT_INSTRUCTION_SET,
    INSTRUCTION_ROOT,
    INSTRUCTION_SET_CHOICES,
    instruction_id_from_payload,
    iter_instruction_files,
    load_instruction,
    map_id_from_instruction_path,
)
from scripts.methods.util.methods import save_trajectory_image_for_record
from scripts.methods.util.workers import run_instruction_jobs


METHOD_NAME = "Optimal Scene Graph Planning"
METHOD_SLUG = "OSGLLM"
METHOD_ROOT = REPO_ROOT / "resources" / "methods" / METHOD_SLUG


def scene_id_from_instruction(
    instruction: Mapping[str, object],
    map_id: str,
) -> str:
    scene_id = instruction.get("map_id")
    if isinstance(scene_id, str) and scene_id.strip():
        return scene_id.strip()
    return map_id


def build_prediction_record(
    instruction_file: Path,
    *,
    map_id: str,
    scene_id: str,
    instruction_id: str,
    instruction: Mapping[str, object],
    trajectory: list[list[int]],
    osgllm_metadata: dict[str, object],
    metrics: dict[str, object] | None,
) -> dict[str, object]:
    difficulty_level = difficulty_from_instruction(instruction)
    return {
        "version": 1,
        "method": METHOD_NAME,
        "prediction_id": f"{METHOD_SLUG}_{uuid.uuid4().hex[:8]}",
        "map_id": map_id,
        "scene_id": scene_id,
        "instruction_id": instruction_id,
        "difficulty_level": difficulty_level,
        "instruction_file": display_path(instruction_file),
        "created_at": iso_now(),
        "trajectory": trajectory,
        "metrics": metrics,
        "metrics_summary": metric_summary(metrics),
        "runtime_seconds": 0.0,
        "runtime": {
            "seconds": 0.0,
            "status": "written",
        },
        "instruction": {
            "text": instruction.get("instruction", ""),
            "difficulty_level": instruction.get("difficulty_level", ""),
            "template_instruction_id": instruction.get("template_instruction_id"),
        },
        "osgllm": osgllm_metadata,
    }


def start_only_trajectory(
    instruction: Mapping[str, object],
) -> list[list[int]]:
    """Return a valid zero-length path for an episode-level failure."""
    start_pose = instruction.get("start_pose")
    if not isinstance(start_pose, Mapping):
        return []
    row = start_pose.get("row")
    col = start_pose.get("col")
    if (
        isinstance(row, int)
        and not isinstance(row, bool)
        and isinstance(col, int)
        and not isinstance(col, bool)
    ):
        return [[row, col]]
    return []


def build_all(
    input_root: Path,
    output_root: Path,
    *,
    overwrite: bool,
    instruction_set: str = DEFAULT_INSTRUCTION_SET,
    limit: int | None = None,
    config: OSGLLMConfig | None = None,
    workers: int = 1,
) -> list[dict[str, object]]:
    config = config or OSGLLMConfig()
    results: list[dict[str, object]] = []
    instruction_files = iter_instruction_files(
        input_root,
        instruction_set=instruction_set,
    )
    if limit is not None:
        instruction_files = instruction_files[:limit]

    total = len(instruction_files)
    def run_one(index: int, instruction_file: Path) -> dict[str, object]:
        episode_start = time.perf_counter()
        instruction = load_instruction(instruction_file)
        map_id = map_id_from_instruction_path(instruction_file, input_root)
        scene_id = scene_id_from_instruction(instruction, map_id)
        instruction_id = instruction_id_from_payload(instruction_file, instruction)
        output_path = output_path_for_prediction(output_root, map_id, instruction_id)

        if output_path.exists() and not overwrite:
            result = load_existing_result(output_path, map_id, instruction_id)
            result["scene_id"] = scene_id
        else:
            map_state: Mapping[str, object] | None = None
            method_start: float | None = None
            method_seconds: float | None = None
            stage = "load_map_state"
            try:
                method_start = time.perf_counter()
                map_state = load_map_state(map_id)
                stage = "build_trajectory"
                trajectory, osgllm_metadata = build_osgllm_trajectory(
                    map_state,
                    instruction,
                    config=config,
                )
                method_seconds = time.perf_counter() - method_start
                stage = "evaluate_prediction"
                metrics = evaluate_prediction(
                    trajectory,
                    map_id=map_id,
                    instruction_id=instruction_id,
                )
                stage = "build_prediction_record"
                record = build_prediction_record(
                    instruction_file=instruction_file,
                    map_id=map_id,
                    instruction_id=instruction_id,
                    scene_id=scene_id,
                    instruction=instruction,
                    trajectory=trajectory,
                    osgllm_metadata=osgllm_metadata,
                    metrics=metrics,
                )
                stage = "save_trajectory_images"
                save_trajectory_image_for_record(
                    record,
                    map_state,
                    trajectory,
                    output_path,
                    nested_record_keys=("osgllm",),
                    instruction=instruction,
                )
                runtime_seconds = time.perf_counter() - episode_start
                record["runtime_seconds"] = runtime_seconds
                record["runtime"] = {
                    "seconds": runtime_seconds,
                    "method_seconds": method_seconds,
                    "status": "written",
                }
                osgllm = record.get("osgllm")
                if isinstance(osgllm, dict):
                    osgllm["runtime_seconds"] = runtime_seconds
                stage = "write_prediction_record"
                write_prediction_record(output_path, record)
                result = result_from_prediction_record(record, output_path)
            except Exception as exc:  # pragma: no cover - defensive runner guard
                runtime_seconds = time.perf_counter() - episode_start
                exception_traceback = traceback.format_exc()
                error_text = f"{type(exc).__name__}: {exc}"
                try:
                    if map_state is None:
                        map_state = load_map_state(map_id)
                    trajectory = start_only_trajectory(instruction)
                    metrics = worst_case_metrics_for_evaluation_error(
                        trajectory,
                        instruction,
                        map_state,
                        error=f"OSGLLM {stage}: {error_text}",
                    )
                    failure = {
                        "policy": "worst_case",
                        "stage": stage,
                        "error": error_text,
                        "traceback": exception_traceback,
                    }
                    record = build_prediction_record(
                        instruction_file=instruction_file,
                        map_id=map_id,
                        instruction_id=instruction_id,
                        scene_id=scene_id,
                        instruction=instruction,
                        trajectory=trajectory,
                        osgllm_metadata={
                            "status": "EXECUTION_ERROR_WORST_CASE",
                            "failure": failure,
                            "runtime_seconds": runtime_seconds,
                        },
                        metrics=metrics,
                    )
                    record["execution_fallback"] = failure
                    record["runtime_seconds"] = runtime_seconds
                    elapsed_method_seconds = (
                        time.perf_counter() - method_start
                        if method_start is not None
                        else None
                    )
                    record["runtime"] = {
                        "seconds": runtime_seconds,
                        "method_seconds": elapsed_method_seconds,
                        "status": "written_worst_case",
                    }
                    write_prediction_record(output_path, record)
                    result = result_from_prediction_record(record, output_path)
                    result["status"] = "written_worst_case"
                    result["error"] = error_text
                except Exception as fallback_exc:  # pragma: no cover - disk/map failure
                    result = {
                        "instruction_id": instruction_id,
                        "map_id": map_id,
                        "scene_id": scene_id,
                        "status": "failed",
                        "path": display_path(output_path),
                        "difficulty_level": difficulty_from_instruction(instruction),
                        "runtime_seconds": runtime_seconds,
                        "runtime": {"seconds": runtime_seconds, "status": "failed"},
                        "error": (
                            f"{error_text}; worst-case record write failed: "
                            f"{type(fallback_exc).__name__}: {fallback_exc}"
                        ),
                    }

        return result

    for index, result in run_instruction_jobs(
        instruction_files,
        workers=workers,
        run_one=run_one,
    ):
        results.append(result)
        print_episode_result(index, total, result)

    written = sum(
        1
        for item in results
        if item["status"] in {"written", "written_worst_case"}
    )
    worst_case = sum(
        1 for item in results if item["status"] == "written_worst_case"
    )
    skipped = sum(1 for item in results if item["status"] == "skipped_exists")
    failed = sum(1 for item in results if item["status"] == "failed")
    print(
        f"total={len(results)} written={written} skipped={skipped} "
        f"worst_case={worst_case} failed={failed}",
        flush=True,
    )
    return results


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Run the SemPathBench adapter for Optimal Scene Graph Planning."
    )
    parser.add_argument("--input-root", type=Path, default=INSTRUCTION_ROOT)
    parser.add_argument("--output-root", type=Path, default=METHOD_ROOT)
    parser.add_argument(
        "--set",
        dest="instruction_set",
        choices=INSTRUCTION_SET_CHOICES,
        default=DEFAULT_INSTRUCTION_SET,
    )
    parser.add_argument(
        "--translation-mode",
        choices=("heuristic", "llm", "auto"),
        default="heuristic",
    )
    parser.add_argument(
        "--grounding-mode",
        choices=("heuristic", "llm", "auto"),
        default="heuristic",
    )
    parser.add_argument(
        "--planner",
        choices=("product", "hierarchical", "amra"),
        default="product",
    )
    parser.add_argument("--object-reach-radius", type=int, default=20)
    parser.add_argument("--max-expansions", type=int, default=250_000)
    parser.add_argument("--max-planning-seconds", type=float, default=30.0)
    parser.add_argument(
        "--unlimited-planning",
        action="store_true",
        help="Disable both the product A* time limit and expansion limit.",
    )
    parser.add_argument(
        "--disable-fallback",
        action="store_true",
        help="Score failed product A* attempts with a start-only trajectory instead of using hierarchy/sequential fallbacks.",
    )
    parser.add_argument("--model", default=configured_model())
    parser.add_argument("--llm-cache-root", type=Path, default=METHOD_ROOT / "_llm_cache")
    parser.add_argument("--overwrite-llm-cache", action="store_true")
    parser.add_argument(
        "--llm-cache-only",
        action="store_true",
        help="Require existing LLM cache entries and never call the configured LLM API.",
    )
    parser.add_argument("--use-llm-heuristic", action="store_true")
    parser.add_argument("--disable-llm-heuristic", action="store_true")
    parser.add_argument("--overwrite", action="store_true")
    parser.add_argument("--limit", type=int)
    parser.add_argument("--workers", type=int, default=1, help="Number of independent instruction episodes to run concurrently.")
    parser.add_argument(
        "--evaluate",
        action="store_true",
        help="Deprecated: metrics are always computed with the shared evaluator.",
    )
    parser.add_argument("--verbose", action="store_true")
    return parser.parse_args()


def main() -> None:
    args = parse_args()
    if args.llm_cache_only and args.overwrite_llm_cache:
        raise SystemExit("--llm-cache-only cannot be combined with --overwrite-llm-cache")
    config = OSGLLMConfig(
        translation_mode=args.translation_mode,
        grounding_mode=args.grounding_mode,
        planner=args.planner,
        object_reach_radius=args.object_reach_radius,
        max_expansions=None if args.unlimited_planning else args.max_expansions,
        max_planning_seconds=None if args.unlimited_planning else args.max_planning_seconds,
        disable_fallback=args.disable_fallback,
        llm_cache_only=args.llm_cache_only,
        use_llm_heuristic=args.use_llm_heuristic and not args.disable_llm_heuristic,
        model=args.model,
        llm_cache_root=args.llm_cache_root,
        overwrite_llm_cache=args.overwrite_llm_cache,
        verbose=args.verbose,
    )
    results = build_all(
        args.input_root,
        args.output_root,
        overwrite=args.overwrite,
        instruction_set=args.instruction_set,
        limit=args.limit,
        config=config,
        workers=args.workers,
    )
    # Build one complete summary from disk. This includes predictions from
    # previous interrupted runs without rewriting it for every resumed skip.
    complete_results = collect_prediction_results(
        args.output_root,
        method_name=METHOD_NAME,
    )
    summary_path = write_summary(
        complete_results,
        args.input_root,
        args.output_root,
        method_name=METHOD_NAME,
        evaluate=True,
    )
    print_summary(summary_path)


if __name__ == "__main__":
    main()
